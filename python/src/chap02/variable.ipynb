   "source": [
    "# inch 단위를 cm 단위로 변경하기\n",
    "# 숫자를 입력받습니다.\n",
    "raw_input = input(\"inch 단위의 숫자를 입력해주세요: \") # 리턴 값은 문자형(큰따옴표 또는 작은 따옴표를 붙어서 반환)\n",
    "# 입력받은 데이터를 숫자 자료형으로 변경하고, cm 단위로 변경합니다.\n",
    "inch = int(raw_input)\n",
    "cm = inch * 2.54\n",
    "\n",
    "# 출력합니다.\n",
    "print(inch, \"inch는 cm 단위로\", cm, \"cm입니다.\")"
   ]
